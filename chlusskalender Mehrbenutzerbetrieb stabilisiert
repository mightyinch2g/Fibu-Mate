[32m+[m[32mdef _fm505b_normalize_header(value):[m
[32m+[m[32m    import unicodedata as _ud[m
[32m+[m[32m    text=_ud.normalize('NFKC',str(value or ''))[m
[32m+[m[32m    text=text.replace('\ufeff','').replace('\u200b','').replace('\xa0',' ')[m
[32m+[m[32m    text=re.sub(r'\s+',' ',text).strip().casefold()[m
