[32m+[m[32m    vals=[][m
[32m+[m[32m    for srec in series:[m
[32m+[m[32m        vals.extend([float(srec.get('values', {}).get(m) or 0) for m in months])[m
[32m+[m[32m    max_v=max(vals) if vals else 1; min_v=min(vals) if vals else 0[m
[32m+[m[32m    if max_v == min_v: min_v = 0[m
[32m+[m[32m    left=x+42; right=x+w-28; top=y+46; bottom=y+h-42[m
[32m+[m[32m    canvas.create_line(left,bottom,right,bottom,fill=LINE)[m
