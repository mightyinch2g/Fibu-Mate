[32m+[m[32mdef _fm505b_find_header(workbook):[m
[32m+[m[32m    aliases={[m
[32m+[m[32m        'Buchung': {'buchung','buchungsdatum','buchungstag'},[m
[32m+[m[32m        'Wertstellung': {'wertstellung','wertstellungsdatum','valuta','valutadatum'},[m
[32m+[m[32m        'Buchungstext': {'buchungstext','buchungsart','umsatzart'},[m
[32m+[m[32m        'Verwendungszweck': {'verwendungszweck','verwendungszweck1','vz','zahlungsreferenz'},[m
[32m+[m[32m        'Verwendungszweck 2': {'verwendungszweck2','verwendungszweckii','vz2'},[m
[32m+[m[32m        'Betrag': {'betrag','umsatz','umsatzbetrag','betragwaehrung'},[m
[32m+[m[32m        'Währung': {'währung','waehrung','currency'},[m
[32m+[m[32m        'GVC': {'gvc'}, 'BTC': {'btc'},[m
[32m+[m[32m    }[m
[32m+[m[32m    alias_norm={k:{_fm505b_normalize_header(x) for x in vals} for k,vals in aliases.items()}[m
[32m+[m[32m    required={'Buchung','Wertstellung','Buchungstext','Verwendungszweck','Betrag'}[m
[32m+[m[32m    best=None[m
[32m+[m[32m    for ws in workbook.worksheets:[m
[32m+[m[32m        for row_idx in range(1,min(max(1,int(ws.max_row or 1)),50)+1):[m
[32m+[m[32m            mapping={}; raw=[][m
[32m+[m[32m            for col_idx in range(1,min(max(1,int(ws.max_column or 1)),100)+1):[m
[32m+[m[32m                value=ws.cell(row=row_idx,column=col_idx).value[m
[32m+[m[32m                if value is None or str(value).strip()=='': continue[m
[32m+[m[32m                raw.append(str(value).strip())[m
[32m+[m[32m                norm=_fm505b_normalize_header(value)[m
[32m+[m[32m                for canonical,variants in alias_norm.items():[m
[32m+[m[32m                    if norm in variants and canonical not in mapping:[m
[32m+[m[32m                        mapping[canonical]=col_idx; break[m
[32m+[m[32m            score=len(required.intersection(mapping))[m
[32m+[m[32m            if best is None or score>best[0]: best=(score,ws,row_idx,mapping,raw)[m
[32m+[m[32m            if required.issubset(mapping): return ws,row_idx,mapping[m
[32m+[m[32m    score,ws,row_idx,mapping,raw=best or (0,workbook.active,1,{},[])[m
[32m+[m[32m    missing=sorted(required.difference(mapping))[m
[32m+[m[32m    raise ValueError('Die SFIRM-Kopfzeile konnte nicht vollständig erkannt werden. Fehlende Spalten: '+', '.join(missing)+f'\n\nBestes Ergebnis: Tabellenblatt "{ws.title}", Zeile {row_idx}. Gefundene Spalten: '+(', '.join(raw[:20]) if raw else 'keine'))[m
