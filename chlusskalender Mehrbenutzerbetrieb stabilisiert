[32m+[m[32m            'stueckkosten': unit, 'gesamtbetrag': total, 'berechneter_betrag': calc,[m
[32m+[m[32m            'abweichung': diff, 'plausibel': 1 if abs(diff) < 0.011 else 0,[m
[32m+[m[32m            'sort_order': order, 'raw_line': g.group(0).strip()[m
[32m+[m[32m        })[m
[32m+[m
[32m+[m[32m    m = _re.search(r'Mindestbetrag\s+([\d\.]+,\d{2})', text)[m
[32m+[m[32m    if m:[m
[32m+[m[32m        order += 1[m
[32m+[m[32m        amount = _fm501_de_float(m.group(1))[m
[32m+[m[32m        result['items'].append({[m
