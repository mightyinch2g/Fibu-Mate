[32m+[m[32m    canvas.create_rectangle(x, y, x+w, y+h, fill=WHITE, outline=LINE)[m
[32m+[m[32m    canvas.create_text(x+14, y+14, text=title, fill=BLUE, font=body_font(12,'bold'), anchor='w')[m
[32m+[m[32m    months = list(data.get('months') or [])[m
[32m+[m[32m    series = list(data.get('series') or [])[m
[32m+[m[32m    if not months or not series:[m
[32m+[m[32m        canvas.create_text(x+w/2, y+h/2, text='Keine Daten für die gewählten Kostenarten.', fill=TEXT2, font=body_font(10))[m
