[32m+[m[32m        return False[m
[32m+[m[32m    if filters.get('bis') and get('abschlussdatum') and get('abschlussdatum') > filters['bis']:[m
[32m+[m[32m        return False[m
[32m+[m[32m    if filters.get('gv') and filters['gv'].lower() not in get('geschaeftsvorfall').lower():[m
