[32m+[m[32m            yy=bottom-(bottom-top)*((val-min_v)/(max_v-min_v if max_v!=min_v else 1))[m
[32m+[m[32m            pts.append((xx,yy,m,val))[m
[32m+[m[32m        color=colors[si % len(colors)][m
[32m+[m[32m        for a,b in zip(pts, pts[1:]): canvas.create_line(a[0],a[1],b[0],b[1],fill=color,width=2)[m
[32m+[m[32m        for xx,yy,m,val in pts: canvas.create_oval(xx-2,yy-2,xx+2,yy+2,fill=color,outline=color)[m
[32m+[m[32m        canvas.create_text(x+14, y+36+(si*14), text=str(srec.get('name') or '')[:34], fill=color, font=body_font(8), anchor='w')[m
[32m+[m[32m    for i,m in enumerate(months):[m
[32m+[m[32m        xx=left+(right-left)*(i/(max(1,n-1)))[m
[32m+[m[32m        canvas.create_text(xx,bottom+14,text=str(m)[-5:],fill=TEXT2,font=body_font(8))[m
