[32m+[m[32mdef _fm506_chart_data(filters, metric='brutto', chart_type='months'):[m
[32m+[m[32m    if chart_type != 'unit_dev':[m
[32m+[m[32m        return _FM506_PREV_CHART_DATA(filters, metric, chart_type)[m
[32m+[m[32m    items = _fm505_fetch_items(filters)[m
[32m+[m[32m    selected = _fm506_split_gv_selection(filters.get('gv'))[m
[32m+[m[32m    if not selected:[m
[32m+[m[32m        selected = ['Alle ausgewählten Kosten'][m
[32m+[m[32m    series_map = {name: {} for name in selected}[m
[32m+[m[32m    all_months = set()[m
[32m+[m[32m    for item in items:[m
[32m+[m[32m        gv = str(item.get('geschaeftsvorfall') or '')[m
[32m+[m[32m        monat = item.get('monat_key') or ''[m
[32m+[m[32m        if not monat:[m
[32m+[m[32m            continue[m
[32m+[m[32m        for name in selected:[m
[32m+[m[32m            if name != 'Alle ausgewählten Kosten' and name.lower() not in gv.lower():[m
[32m+[m[32m                continue[m
[32m+[m[32m            anz = float(item.get('anzahl') or 0)[m
[32m+[m[32m            ges = float(item.get('gesamtbetrag') or 0)[m
[32m+[m[32m            rec = series_map.setdefault(name, {}).setdefault(monat, {'gesamt': 0.0, 'anzahl': 0.0})[m
[32m+[m[32m            rec['gesamt'] += ges; rec['anzahl'] += anz; all_months.add(monat)[m
[32m+[m[32m    months = sorted(all_months)[m
[32m+[m[32m    out_series = [][m
[32m+[m[32m    for name, month_map in series_map.items():[m
[32m+[m[32m        values = {}[m
[32m+[m[32m        for m, rec in month_map.items():[m
[32m+[m[32m            values[m] = (rec['gesamt'] / rec['anzahl']) if rec.get('anzahl') else 0[m
[32m+[m[32m        if values:[m
[32m+[m[32m            out_series.append({'name': name, 'values': values})[m
[32m+[m[32m    return {'months': months, 'series': out_series}, 'avg_unit', 'monat_key'[m
